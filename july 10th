// 3 constructor
function mouseConstructor(color,size,weight){


    this.color = color
    this.size = size
    this.weight = weight
    this.leftClick = function leftClick(){ //function definition
        console.log('left button clicked!')
    }
   this.rightClick = ()=>{ //arrow function anonymous
        console.log('right button clicked!')
    }
    this.middleClick= function(){ //function expression anonymous
        console.log('middle button clicked!')
    }
    }
const secondMouse = new mouseConstructor('red', 3,2)
